<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- DRAGON 착용형 140mm 대전차 유도탄.
       공용 127mm 유도 기반을 재사용하되 더 큰 탄두의 관통/폭발 성능을 반영한다. -->
  <ThingDef ParentName="Base127mmMissile">
    <defName>Bullet_KOR_Dragon_HEAT_CE</defName>
    <label>140mm DRAGON anti-tank guided missile</label>
    <graphicData>
      <texPath>Things/Projectile/Dragonms</texPath>
      <!-- 원본 DragonA~I 프레임 디렉터리를 사용하는 애니메이션 그래픽. -->
      <graphicClass>Graphic_Flicker</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>1.3</drawSize>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>Bullet</damageDef>
      <damageAmountBase>140</damageAmountBase>
      <armorPenetrationSharp>620</armorPenetrationSharp>
      <armorPenetrationBlunt>45</armorPenetrationBlunt>
      <speed>15</speed>
    </projectile>
    <comps Inherit="False">
      <li Class="CombatExtended.CompProperties_ExplosiveCE">
        <damageAmountBase>150</damageAmountBase>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <explosiveRadius>1.7</explosiveRadius>
        <explosionSound>MortarBomb_Explode</explosionSound>
        <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
      </li>
      <li Class="CombatExtended.CompProperties_Fragments">
        <fragments>
          <Fragment_Large>8</Fragment_Large>
          <Fragment_Small>14</Fragment_Small>
        </fragments>
        <fragAngleRange>-20~20</fragAngleRange>
      </li>
      <!-- comps Inherit="False"이므로 127mm 기반의 복합 트레일을 명시적으로 복원한다. -->
      <li Class="CombatExtended.CompProperties_ProjectileFleck">
        <FleckDatas>
          <li>
            <fleck>Fleck_CERocketFlame</fleck>
            <emissionsPerTick>2</emissionsPerTick>
            <flecksPerEmission>2</flecksPerEmission>
            <scale>1.6</scale>
            <cutoffTickRange>25~60</cutoffTickRange>
            <originOffset>0.4</originOffset>
          </li>
          <li>
            <fleck>Fleck_CERocketSmokeTrail</fleck>
            <emissionsPerTick>1</emissionsPerTick>
            <flecksPerEmission>1</flecksPerEmission>
            <rotation>0~360</rotation>
            <scale>1.6</scale>
          </li>
          <li>
            <fleck>Fleck_CERocketSmoke</fleck>
            <emissionsPerTick>1</emissionsPerTick>
            <flecksPerEmission>1</flecksPerEmission>
            <rotation>0~360</rotation>
            <scale>1.1</scale>
            <cutoffTickRange>25~60</cutoffTickRange>
          </li>
        </FleckDatas>
      </li>
    </comps>
  </ThingDef>

  <!-- PF 착용형 110mm 텐덤탄두 대전차 로켓 (무유도).
       DRAGON(유도 미사일)과 달리 직사 로켓 - Base127mmMissile(호밍) 대신 BaseBulletCE 사용.
       텐덤 HEAT라 관통은 높되 사거리/유도는 없음. 5발 충전식. -->
  <ThingDef Name="Base_KOR_PF" ParentName="BaseBulletCE" Abstract="true">
    <thingClass>CombatExtended.BulletCE</thingClass>
    <graphicData>
      <texPath>Things/Projectile/Rocket_120mm_HE</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
      <drawSize>1.0</drawSize>
    </graphicData>
    <projectile Class="CombatExtended.ProjectilePropertiesCE">
      <damageDef>Bullet</damageDef>
      <damageAmountBase>80</damageAmountBase> <!-- HEAT 관통제트 직격 -->
      <armorPenetrationSharp>480</armorPenetrationSharp> <!-- 텐덤 HEAT: 고관통(DRAGON 620보다 아래) -->
      <armorPenetrationBlunt>40</armorPenetrationBlunt>
      <speed>40</speed> <!-- 무유도 로켓 -->
      <flyOverhead>false</flyOverhead>
      <soundAmbient>RocketPropelledLoop_Small</soundAmbient>
    </projectile>
    <comps>
      <li Class="CombatExtended.CompProperties_ExplosiveCE">
        <damageAmountBase>100</damageAmountBase>
        <explosiveDamageType>Bomb</explosiveDamageType>
        <explosiveRadius>1.5</explosiveRadius>
        <explosionSound>MortarBomb_Explode</explosionSound>
        <applyDamageToExplosionCellsNeighbors>true</applyDamageToExplosionCellsNeighbors>
      </li>
      <li Class="CombatExtended.CompProperties_Fragments">
        <fragments>
          <Fragment_Large>4</Fragment_Large>
          <Fragment_Small>8</Fragment_Small>
        </fragments>
      </li>
      <li Class="CombatExtended.CompProperties_ProjectileFleck">
        <FleckDatas>
          <li>
            <fleck>Fleck_CERocketFlame</fleck>
            <emissionsPerTick>2</emissionsPerTick>
            <flecksPerEmission>1</flecksPerEmission>
            <scale>1.2</scale>
            <cutoffTickRange>20~50</cutoffTickRange>
          </li>
          <li>
            <fleck>Fleck_CERocketSmokeTrail</fleck>
            <emissionsPerTick>1</emissionsPerTick>
            <flecksPerEmission>1</flecksPerEmission>
            <rotation>0~360</rotation>
            <scale>1.3</scale>
          </li>
        </FleckDatas>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="Base_KOR_PF">
    <defName>Bullet_KOR_PF_HEAT_CE</defName>
    <label>110mm tandem-warhead anti-tank rocket</label>
  </ThingDef>

</Defs>
