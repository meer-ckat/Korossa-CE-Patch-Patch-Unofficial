            </parts>
          </li>
          <li>
            <ArmorRating_Sharp>0.27</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.27</ArmorRating_Blunt>
            <parts>
              <li>ArtificialBrain</li>
              <li>Reactor</li>
              <li>FluidReprocessor</li>
              <li>BulbTurret</li>
            </parts>
          </li>
        </stats>
      </li>
    </value>
  </Operation>
	<!-- 대상: Mech_ADlunchbox. CE 운반 중량/부피 추가. -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Mech_ADlunchbox"]/statBases</xpath>
		<value>
