	<!-- 골리앗 (Goliath) -->
  <!-- 대상: Mech_krsgoliath. 전체 장갑을 5/5로 재설정(Sd.Kfz.302 Goliath 5mm 연강 차체 기준). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Mech_krsgoliath"]/statBases/ArmorRating_Sharp</xpath>
    <!-- Sd.Kfz. 302 Goliath의 약 5 mm 연강 차체 기준 -->
    <value><ArmorRating_Sharp>5</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Mech_krsgoliath"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>5</ArmorRating_Blunt></value>
  </Operation>
  <!-- 대상: Mech_krsgoliath. PartialArmorExt로 Leg/Foot·센서·내부부품 부위별 장갑 배율 부여. -->
