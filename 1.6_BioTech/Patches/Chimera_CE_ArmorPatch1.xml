	<!-- ============================================================
	     해병 (haebyung) — 장갑 누락 보정
	     원본값 Sharp 0.90 / Blunt 0.25는 바닐라 스케일(0~1 비율)이라
	     CE(mm RHA / MPa)에서는 사실상 장갑 0이었다. 9mm 권총탄도 관통한다.
	     M113 계열(ADlunchbox/TOWlunchbox)과 동일 차체이므로 30/30으로 통일.
	     ============================================================ -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Mech_haebyung"]/statBases/ArmorRating_Sharp</xpath>
		<value><ArmorRating_Sharp>30</ArmorRating_Sharp></value>
	</Operation>
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Mech_haebyung"]/statBases/ArmorRating_Blunt</xpath>
		<value><ArmorRating_Blunt>30</ArmorRating_Blunt></value>
	</Operation>
	<!-- 대상: Mech_haebyung. PartialArmorExt로 부위별 장갑 배율 부여(M113 계열과 동일 값). -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/ThingDef[defName="Mech_haebyung"]</xpath>
		<value>
			<li Class="CombatExtended.PartialArmorExt">
				<stats>
					<li>
						<ArmorRating_Sharp>0.53</ArmorRating_Sharp>
						<ArmorRating_Blunt>0.53</ArmorRating_Blunt>
						<parts>
							<li>Leg</li>
							<li>Foot</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.27</ArmorRating_Sharp>
						<ArmorRating_Blunt>0.27</ArmorRating_Blunt>
						<parts>
							<li>SightSensor</li>
							<li>HearingSensor</li>
							<li>SmellSensor</li>
						</parts>
					</li>
					<li>
						<ArmorRating_Sharp>0.27</ArmorRating_Sharp>
						<ArmorRating_Blunt>0.27</ArmorRating_Blunt>
						<parts>
							<li>ArtificialBrain</li>
							<li>Reactor</li>
							<li>FluidReprocessor</li>
							<li>BulbTurret</li>
						</parts>
					</li>
				</stats>
			</li>
		</value>
