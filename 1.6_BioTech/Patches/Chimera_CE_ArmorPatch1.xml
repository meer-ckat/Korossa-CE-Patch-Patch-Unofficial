<Patch>
  <!-- 셰리든 (Sheridan) -->
  <!-- M551은 중전차가 아니라 고기동 정찰/공수 경전차다.
       코로사 M113 계열(4.0)보다 빠르고 비무장 경량 로버(5.0)보다는 느리게 설정. -->
  <!-- 대상: Mech_Sheridan. MoveSpeed를 4.6으로 교체(속도 재설정). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Mech_Sheridan"]/statBases/MoveSpeed</xpath>
    <value><MoveSpeed>4.6</MoveSpeed></value>
  </Operation>
  <!-- 대상: Mech_Sheridan. 캐러밴 이동 시 속도 배율(CaravanRidingSpeedFactor) 추가. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Mech_Sheridan"]/statBases</xpath>
    <value><CaravanRidingSpeedFactor>1.35</CaravanRidingSpeedFactor></value>
  </Operation>

  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Mech_Sheridan"]/statBases/ArmorRating_Sharp</xpath>
    <value><ArmorRating_Sharp>30</ArmorRating_Sharp></value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="Mech_Sheridan"]/statBases/ArmorRating_Blunt</xpath>
    <value><ArmorRating_Blunt>30</ArmorRating_Blunt></value>
  </Operation>
  <!-- 대상: Mech_Sheridan. CE PartialArmorExt로 부위별(Torso/Leg·Foot/센서/내부부품) 장갑 배율 세분화. -->
  <Operation Class="PatchOperationAddModExtension">
    <xpath>Defs/ThingDef[defName="Mech_Sheridan"]</xpath>
    <value>
      <li Class="CombatExtended.PartialArmorExt">
        <stats>
          <li>
            <ArmorRating_Sharp>1.0</ArmorRating_Sharp>
            <ArmorRating_Blunt>1.0</ArmorRating_Blunt>
            <parts>
              <li>Torso</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Sharp>0.5</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.5</ArmorRating_Blunt>
            <parts>
              <li>Leg</li>
              <li>Foot</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <parts>
              <li>SightSensor</li>
              <li>HearingSensor</li>
              <li>SmellSensor</li>
            </parts>
          </li>
          <li>
            <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
            <ArmorRating_Blunt>0.25</ArmorRating_Blunt>
            <parts>
              <li>ArtificialBrain</li>
              <li>Reactor</li>
              <li>FluidReprocessor</li>
              <li>BulbTurret</li>
            </parts>
          </li>
        </stats>
      </li>
    </value>
  </Operation>
  <!-- 대상: Mech_Sheridan. CE 운반 중량/부피(CarryWeight/CarryBulk) 추가. -->
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="Mech_Sheridan"]/statBases</xpath>
    <value>
      <CarryWeight>400</CarryWeight>
      <CarryBulk>350</CarryBulk>
    </value>
  </Operation>

  <!-- 런치박스 (LUNCHBOX) -->
