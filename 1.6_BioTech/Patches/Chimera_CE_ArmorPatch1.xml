	<!-- 대상: Mech_haebyung. CE 운반 중량/부피 추가(무장 제거한 수송/기승용 차량). -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Mech_haebyung"]/statBases</xpath>
		<value>
