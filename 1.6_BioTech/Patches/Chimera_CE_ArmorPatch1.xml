			<CarryBulk>450</CarryBulk>
		</value>
	</Operation>

	<!-- ============================================================
	     히비키 (HIBIKI) — 장갑 누락 보정
	     원본 statBases에 ArmorRating 자체가 없어 LightMechanoid 부모의
	     바닐라 값을 그대로 상속받고 있었다(= CE 기준 장갑 0).
	     경량 프로토타입 UGV(combatPower 45)이므로 CE 공식 밀리터 패치와
	     동일한 Sharp 2.5 / Blunt 4를 쓴다. Replace가 아니라 Add여야 한다.
	     ============================================================ -->
	<Operation Class="PatchOperationAdd">
		<xpath>Defs/ThingDef[defName="Mech_HIBIKI"]/statBases</xpath>
		<value>
			<ArmorRating_Sharp>2.5</ArmorRating_Sharp>
			<ArmorRating_Blunt>4</ArmorRating_Blunt>
		</value>
	</Operation>

</Patch>
