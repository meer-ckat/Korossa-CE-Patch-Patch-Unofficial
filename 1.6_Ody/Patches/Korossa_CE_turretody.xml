<?xml version="1.0" encoding="utf-8"?>
<Patch>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[@Name="Korossa_Turret"]/thingClass</xpath>
        <value>
            <thingClass>CombatExtended.Building_TurretGunCE</thingClass>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Korossa_building_CIWS"]/building/turretBurstWarmupTime</xpath>
        <value>
            <turretBurstWarmupTime>0.1</turretBurstWarmupTime>
        </value>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Korossa_building_CIWS"]/building/turretBurstCooldownTime</xpath>
        <value>
            <turretBurstCooldownTime>0.15</turretBurstCooldownTime>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Korossa_building_CIWS"]</xpath>
        <value>
            <thingClass>CombatExtended.Building_CIWS_CE</thingClass>
        </value>
    </Operation>

    <Operation Class="PatchOperationRemove">
        <xpath>Defs/ThingDef[defName="Korossa_building_CIWS"]/comps/li[@Class="CompProperties_Refuelable"]</xpath>
    </Operation>

    <Operation Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="Korossa_building_CIWS"]/building/turretGunDef</xpath>
        <value>
            <turretGunDef>Korossa_Pointdefensegun_CE</turretGunDef>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="Korossa_building_CIWS"]/statBases</xpath>
        <value>
            <AimingAccuracy>0.5</AimingAccuracy>
        </value>
    </Operation>

</Patch>