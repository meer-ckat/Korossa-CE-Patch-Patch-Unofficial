	<!-- 방어막 재충전 속도: 0.013(원본) → 0.025 → 2.0(극단 상향) → 0.5(너프).
	     CompShield는 매 틱 energy += EnergyShieldRechargeRate / 60 이므로 초당 0.5.
	     EnergyShieldEnergyMax 3.0 기준 0 → 만충까지 약 6초.
	     (참고: 원본 0.013 = 231초, 직전 0.025 = 120초. 바닐라 방패벨트는 0.13) -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Korossa_BSD_Vest"]/statBases/EnergyShieldRechargeRate</xpath>
		<value>
			<EnergyShieldRechargeRate>0.5</EnergyShieldRechargeRate>
		</value>
	</Operation>

	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Korossa_BSD_Vest"]/statBases/EnergyShieldEnergyMax</xpath>
		<value>
			<EnergyShieldEnergyMax>3.0</EnergyShieldEnergyMax>
		</value>
	</Operation>

	<!-- 방어막이 완전히 깨졌을 때의 재가동 대기시간.
	     18000틱(원본, 300초) → 12000틱(200초) → 300틱(5초, 극단 상향) → 900틱(15초, 너프).
	     energyOnReset 3.0이라 대기 후 만충 상태로 복귀한다. -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="Korossa_BSD_Vest"]/comps/li[@Class="CompProperties_Shield"]</xpath>
		<value>
			<li Class="CompProperties_Shield">
				<startingTicksToReset>900</startingTicksToReset>
				<minDrawSize>1.5</minDrawSize>
				<maxDrawSize>1.5</maxDrawSize>
				<energyLossPerDamage>0.04</energyLossPerDamage>
				<energyOnReset>3.0</energyOnReset>
				<blocksRangedWeapons>false</blocksRangedWeapons>
			</li>
		</value>
	</Operation>

