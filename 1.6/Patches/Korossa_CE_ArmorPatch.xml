	<!-- KRS_vacpack (Odyssey 아파렐): CE 방어/부피 미패치 상태였음.
	     실드 벨트형 경량 생명유지 슈트 - 물리 방어는 가볍게(주 방어는 실드).
	     Odyssey 없으면 def가 없으므로 Conditional로 감싸 에러 방지. -->
	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="KRS_vacpack"]/statBases</xpath>
		<match Class="PatchOperationAdd">
			<xpath>Defs/ThingDef[defName="KRS_vacpack"]/statBases</xpath>
			<value>
				<ArmorRating_Sharp>6</ArmorRating_Sharp>
				<ArmorRating_Blunt>16</ArmorRating_Blunt>
				<ArmorRating_Heat>10</ArmorRating_Heat>
				<Bulk>2</Bulk>
				<WornBulk>1</WornBulk>
			</value>
		</match>
	</Operation>

</Patch>
