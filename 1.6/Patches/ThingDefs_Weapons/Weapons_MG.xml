<?xml version="1.0" encoding="utf-8"?>
<!-- 이 파일: LMG/HMG 5종(M249a/VOLK/VOLK_exotic/M2a/Ameli)을 MakeGunCECompatible로
     CE 변환(Bipod_LMG 태그 부여), 끝에 5종 공통 근접 툴 부여. -->
<Patch>

	<!-- 대상: KJW_M249a (LMG). CE 변환 - 5.56mm 100발 벨트. -->
	<!-- KJW_M249a (LMG) -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_M249a</defName>
		<statBases>
			<SightsEfficiency>0.70</SightsEfficiency>
			<ShotSpread>0.13</ShotSpread>
			<SwayFactor>1.30</SwayFactor>
			<Bulk>8.0</Bulk>
			<Mass>10</Mass>
			<RangedWeapon_Cooldown>2.5</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>2.5</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_M249_KJW</defaultProjectile>
			<warmupTime>1.3</warmupTime>
			<burstShotCount>13</burstShotCount>
			<ticksBetweenBurstShots>5</ticksBetweenBurstShots>
			<range>57</range>
			<soundCast>LMG_fire</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
			<recoilPattern>Mounted</recoilPattern>
		</Properties>
		<AmmoUser>
			<magazineSize>100</magazineSize>
			<reloadTime>7.0</reloadTime>
			<ammoSet>AmmoSet_556x45mmNATO</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>6</aimedBurstShotCount>
			<aiUseBurstMode>FALSE</aiUseBurstMode>
			<aiAimMode>SuppressFire</aiAimMode>
		</FireModes>
		<weaponTags>
			<li>Bipod_LMG</li>
		</weaponTags>
	</Operation>

