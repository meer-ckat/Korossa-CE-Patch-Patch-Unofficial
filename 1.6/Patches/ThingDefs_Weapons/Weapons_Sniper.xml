<?xml version="1.0" encoding="utf-8"?>
<!-- 이 파일: 배틀라이플/저격 계열 3종(SA58a/FNFAL/M1A)을 MakeGunCECompatible로
     CE 변환(7.62x51mm NATO), 끝에 3종 공통 근접 툴 부여. -->
<Patch>

	<!-- 대상: KJW_SA58a (개량 배틀라이플). CE 변환. -->
	<!-- KJW_SA58a (Improved Battle Rifle) -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_SA58a</defName>
		<statBases>
			<SightsEfficiency>1.2</SightsEfficiency>
			<ShotSpread>0.07</ShotSpread>
			<SwayFactor>1.20</SwayFactor>
			<Bulk>6.0</Bulk>
			<Mass>3.5</Mass>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>1.6</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_SA58_KJW</defaultProjectile>
			<warmupTime>1.0</warmupTime>
			<burstShotCount>5</burstShotCount>
			<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
			<range>65</range>
			<soundCast>NATOheavy</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>20</magazineSize>
			<reloadTime>4.5</reloadTime>
			<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiUseBurstMode>TRUE</aiUseBurstMode>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
	</Operation>

	<!-- KJW_FNFAL (Battle Rifle) -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_FNFAL</defName>
		<statBases>
			<SightsEfficiency>0.95</SightsEfficiency>
			<ShotSpread>0.09</ShotSpread>
			<SwayFactor>1.3</SwayFactor>
			<Bulk>6.0</Bulk>
			<Mass>3.5</Mass>
			<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>2.0</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_FNFAL_KJW</defaultProjectile>
			<warmupTime>1.0</warmupTime>
			<burstShotCount>4</burstShotCount>
			<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
			<range>65</range>
			<soundCast>NATOheavy</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>20</magazineSize>
			<reloadTime>4.5</reloadTime>
			<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>2</aimedBurstShotCount>
			<aiUseBurstMode>TRUE</aiUseBurstMode>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
	</Operation>

	<!-- KJW_M1A (Semi-Automatic Hunting Rifle) -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_M1A</defName>
		<statBases>
			<SightsEfficiency>1.4</SightsEfficiency>
			<ShotSpread>0.04</ShotSpread>
			<SwayFactor>1.10</SwayFactor>
			<Bulk>5.5</Bulk>
			<Mass>3.5</Mass>
			<RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>1.7</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_FNFAL_KJW</defaultProjectile>
			<warmupTime>1.0</warmupTime>
			<burstShotCount>1</burstShotCount>
			<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
			<range>70</range>
			<soundCast>Heavy_fire</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>10</magazineSize>
			<reloadTime>5.5</reloadTime>
			<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
		</AmmoUser>
		<FireModes>
			<aiUseBurstMode>FALSE</aiUseBurstMode>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
	</Operation>

	<!-- 근접 툴 패치 (미호 구조 모방) -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
			defName="KJW_SA58a" or
			defName="KJW_FNFAL" or
			defName="KJW_M1A"
			]/tools </xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.55</cooldownTime>
					<chanceFactor>1.5</chanceFactor>
					<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>barrel</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>5</power>
					<cooldownTime>2.02</cooldownTime>
					<armorPenetrationBlunt>1.630</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>muzzle</label>
					<capacities>
						<li>Poke</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.55</cooldownTime>
					<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

</Patch> 
