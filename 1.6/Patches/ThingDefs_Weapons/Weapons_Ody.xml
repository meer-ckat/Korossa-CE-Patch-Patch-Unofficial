<?xml version="1.0" encoding="utf-8"?>
<!-- 이 파일: Odyssey DLC 라이플 3종(SCAR_TAC/TACTICOOL/OSW)을 PatchOperationConditional로
     감싸 DLC 미설치 시 안전하게 스킵하며 CE 변환. -->
<Patch>

	<!-- =========================================================================
	     Odyssey DLC 무기(1.6_Ody)의 3개 라이플 CE 변환.
	     Odyssey 없으면 def가 없으므로 각각 PatchOperationConditional로 감싸 안전 처리.
	     ========================================================================= -->

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="KJW_SCAR_TAC"]</xpath>
		<match Class="CombatExtended.PatchOperationMakeGunCECompatible">
			<defName>KJW_SCAR_TAC</defName>
			<statBases>
				<SightsEfficiency>1.0</SightsEfficiency>
				<ShotSpread>0.08</ShotSpread>
				<SwayFactor>1.20</SwayFactor>
				<Bulk>6.0</Bulk>
				<Mass>3.5</Mass>
				<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			</statBases>
			<Properties>
				<recoilAmount>1.35</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_762x51mmNATO_FMJ</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>55</range>
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<soundCast>NATO_supersonic</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</Properties>
			<AmmoUser>
				<magazineSize>20</magazineSize>
				<reloadTime>4.5</reloadTime>
				<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
			</AmmoUser>
			<FireModes>
				<aimedBurstShotCount>3</aimedBurstShotCount>
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
			</FireModes>
		</match>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="KJW_TACTICOOL"]</xpath>
		<match Class="CombatExtended.PatchOperationMakeGunCECompatible">
			<defName>KJW_TACTICOOL</defName>
			<statBases>
				<SightsEfficiency>0.95</SightsEfficiency>
				<ShotSpread>0.09</ShotSpread>
				<SwayFactor>1.0</SwayFactor>
				<Bulk>5.0</Bulk>
				<Mass>3.5</Mass>
				<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			</statBases>
			<Properties>
				<recoilAmount>1.1</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_556x45mmNATO_FMJ</defaultProjectile>
				<warmupTime>0.9</warmupTime>
				<range>52</range>
				<burstShotCount>3</burstShotCount>
				<ticksBetweenBurstShots>8</ticksBetweenBurstShots>
				<soundCast>NATO_supersonic</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</Properties>
			<AmmoUser>
				<magazineSize>30</magazineSize>
				<reloadTime>4.0</reloadTime>
				<ammoSet>AmmoSet_556x45mmNATO</ammoSet>
			</AmmoUser>
			<FireModes>
				<aimedBurstShotCount>3</aimedBurstShotCount>
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
			</FireModes>
		</match>
	</Operation>

	<Operation Class="PatchOperationConditional">
		<xpath>Defs/ThingDef[defName="KJW_OSW"]</xpath>
		<match Class="CombatExtended.PatchOperationMakeGunCECompatible">
			<defName>KJW_OSW</defName>
			<statBases>
				<SightsEfficiency>1.05</SightsEfficiency>
				<ShotSpread>0.07</ShotSpread>
				<SwayFactor>1.30</SwayFactor>
				<Bulk>7.0</Bulk>
				<Mass>3.5</Mass>
				<RangedWeapon_Cooldown>1.5</RangedWeapon_Cooldown>
			</statBases>
			<Properties>
				<recoilAmount>1.4</recoilAmount>
				<verbClass>CombatExtended.Verb_ShootCE</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_762x51mmNATO_FMJ</defaultProjectile>
				<warmupTime>1.0</warmupTime>
				<range>60</range>
				<burstShotCount>2</burstShotCount>
				<ticksBetweenBurstShots>10</ticksBetweenBurstShots>
				<soundCast>NATO_supersonic</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</Properties>
			<AmmoUser>
				<magazineSize>20</magazineSize>
				<reloadTime>4.5</reloadTime>
				<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
			</AmmoUser>
			<FireModes>
				<aimedBurstShotCount>2</aimedBurstShotCount>
				<aiUseBurstMode>TRUE</aiUseBurstMode>
				<aiAimMode>AimedShot</aiAimMode>
			</FireModes>
		</match>
	</Operation>

</Patch>
