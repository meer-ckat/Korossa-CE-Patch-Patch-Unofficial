			<Mass>2.5</Mass>
			<RangedWeapon_Cooldown>0.8</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>1.1</recoilAmount> <!-- 소음기, 반동↓ -->
