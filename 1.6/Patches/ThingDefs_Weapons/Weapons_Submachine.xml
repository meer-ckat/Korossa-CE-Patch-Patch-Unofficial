		<statBases>
			<SightsEfficiency>0.66</SightsEfficiency> <!-- 초소형, 조준↓ -->
			<ShotSpread>0.19</ShotSpread>
			<SwayFactor>0.70</SwayFactor> <!-- 초경량, 흔들림↓ -->
			<Bulk>2.3</Bulk>
			<Mass>2.2</Mass>
			<RangedWeapon_Cooldown>0.7</RangedWeapon_Cooldown> <!-- 빠른 스냅 -->
		</statBases>
		<Properties>
			<recoilAmount>1.4</recoilAmount> <!-- 초소형, 반동↑ -->
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_TJNC_KJW</defaultProjectile>
			<warmupTime>0.35</warmupTime>
			<burstShotCount>4</burstShotCount>
