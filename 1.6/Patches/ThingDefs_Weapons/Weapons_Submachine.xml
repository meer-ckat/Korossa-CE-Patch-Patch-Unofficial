<?xml version="1.0" encoding="utf-8"?>
<!-- 이 파일: SMG 9종(MPX/MPX_spc/MPX_TAC/SPC/mpsd/TJNC/TACTJNC/Urmmmiforgor/ILLEGAL)을
     MakeGunCECompatible로 CE 변환, 끝에 9종 공통 근접 툴(grip/muzzle) 부여. -->
<Patch>

	<!-- 대상: KJW_MPX (베이스라인 SMG). CE 변환 - 9x19mm 30발. -->
	<!-- KJW_MPX : 베이스라인 올라운더 SMG. 모든 지표 평균, 역할의 기준점 -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_MPX</defName>
		<statBases>
			<SightsEfficiency>0.74</SightsEfficiency>
			<ShotSpread>0.15</ShotSpread>
			<SwayFactor>0.78</SwayFactor>
			<Bulk>2.7</Bulk>
			<Mass>2.6</Mass>
			<RangedWeapon_Cooldown>0.85</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>1.15</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_MPX_KJW</defaultProjectile>
			<warmupTime>0.45</warmupTime>
			<burstShotCount>6</burstShotCount>
			<ticksBetweenBurstShots>4</ticksBetweenBurstShots>
			<range>26</range>
			<soundCast>SMG</soundCast>
			<soundCastTail>GunTail_Light</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>30</magazineSize>
			<reloadTime>3.3</reloadTime>
			<ammoSet>AmmoSet_9x19mmPara</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiUseBurstMode>TRUE</aiUseBurstMode>
			<aiAimMode>Snapshot</aiAimMode>
		</FireModes>
	</Operation>

	<!-- KJW_MPX_spc : SBR/컴팩트. 핸들링·연사↑ 정확도·사거리↓, 근접 돌격용 -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_MPX_spc</defName>
		<statBases>
			<SightsEfficiency>0.68</SightsEfficiency> <!-- 단축형, 조준↓ -->
			<ShotSpread>0.18</ShotSpread> <!-- 짧은 총열, 정확도↓ -->
			<SwayFactor>0.72</SwayFactor> <!-- 짧고 가벼워 흔들림↓ -->
			<Bulk>2.4</Bulk>
			<Mass>2.3</Mass>
			<RangedWeapon_Cooldown>0.75</RangedWeapon_Cooldown> <!-- 스냅사격↑ -->
		</statBases>
		<Properties>
			<recoilAmount>1.3</recoilAmount> <!-- 단총열, 반동↑ -->
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_MPX_KJW</defaultProjectile>
			<warmupTime>0.35</warmupTime> <!-- 빠른 조준 -->
			<burstShotCount>7</burstShotCount>
			<ticksBetweenBurstShots>3</ticksBetweenBurstShots> <!-- 발사속도↑ -->
			<range>22</range> <!-- 단총열, 사거리↓ -->
			<soundCast>SMG</soundCast>
			<soundCastTail>GunTail_Light</soundCastTail>
			<muzzleFlashScale>10</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>30</magazineSize>
			<reloadTime>3.2</reloadTime>
			<ammoSet>AmmoSet_9x19mmPara</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiUseBurstMode>TRUE</aiUseBurstMode>
			<aiAimMode>Snapshot</aiAimMode>
		</FireModes>
	</Operation>

	<!-- KJW_MPX_TAC : 광학+소음. 정밀·저반동 but 아음속탄으로 사거리↓ (소음 대가) -->
