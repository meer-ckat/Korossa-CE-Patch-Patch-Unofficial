	</Operation>

	<!-- 언더배럴 그레네이드 구조 (Hunt:Showdown/lemat.xml 구조 참고) -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[defName="KJW_Retro_AR_A"]/comps/li[@Class="CompProperties_EquippableAbilityReloadable"]</xpath>
		<value>
			<li Class="CombatExtended.CompProperties_UnderBarrel">
				<propsUnderBarrel>
					<magazineSize>1</magazineSize>
					<reloadTime>4.0</reloadTime>
					<ammoSet>AmmoSet_40x46mmGrenade</ammoSet>
				</propsUnderBarrel>
				<verbPropsUnderBarrel>
					<recoilAmount>2.5</recoilAmount>
					<verbClass>CombatExtended.Verb_ShootCE</verbClass>
					<hasStandardCommand>true</hasStandardCommand>
					<defaultProjectile>KOR_riflenade</defaultProjectile>
					<warmupTime>1.35</warmupTime>
					<range>55</range>
					<targetParams>
						<canTargetLocations>true</canTargetLocations>
					</targetParams>
					<soundCast>Shot_IncendiaryLauncher</soundCast>
					<muzzleFlashScale>5</muzzleFlashScale>
					<burstShotCount>1</burstShotCount>
				</verbPropsUnderBarrel>
				<propsFireModesUnderBarrel>
					<aiUseBurstMode>FALSE</aiUseBurstMode>
					<aiAimMode>AimedShot</aiAimMode>
					<aimedBurstShotCount>1</aimedBurstShotCount>
				</propsFireModesUnderBarrel>
			</li>
			<li>
				<compClass>CompEquippable</compClass>
			</li>
		</value>
	</Operation>

	<!-- 근접 툴 패치 (미호 구조 모방) -->
	<Operation Class="PatchOperationReplace">
		<xpath>Defs/ThingDef[
			defName="KJW_SCAR" or
			defName="KJW_SCARH" or
			defName="KJW_RIS" or
			defName="KJW_Retro_AR" or
			defName="KJW_Retro_AR_A"
			]/tools </xpath>
		<value>
			<tools>
				<li Class="CombatExtended.ToolCE">
					<label>stock</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.55</cooldownTime>
					<chanceFactor>1.5</chanceFactor>
					<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>barrel</label>
					<capacities>
						<li>Blunt</li>
					</capacities>
					<power>5</power>
					<cooldownTime>2.02</cooldownTime>
					<armorPenetrationBlunt>1.630</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
				</li>
				<li Class="CombatExtended.ToolCE">
					<label>muzzle</label>
					<capacities>
						<li>Poke</li>
					</capacities>
					<power>8</power>
					<cooldownTime>1.55</cooldownTime>
					<armorPenetrationBlunt>2.755</armorPenetrationBlunt>
					<linkedBodyPartsGroup>Muzzle</linkedBodyPartsGroup>
				</li>
			</tools>
		</value>
	</Operation>

</Patch> 