	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_RIS</defName>
		<statBases>
			<SightsEfficiency>1.02</SightsEfficiency>
			<ShotSpread>0.12</ShotSpread> <!-- 경량형, 정확도↓ -->
