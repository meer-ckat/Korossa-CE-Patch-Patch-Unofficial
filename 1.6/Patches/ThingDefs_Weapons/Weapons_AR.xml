<?xml version="1.0" encoding="utf-8"?>
<!-- 이 파일: 돌격소총 5종(SCAR/SCARH/RIS/Retro_AR/Retro_AR_A)을 MakeGunCECompatible로
     CE 변환, Retro_AR_A는 언더배럴 40mm 그레네이드 컴포넌트 추가, 끝에 5종 공통 근접 툴 부여. -->
<Patch>

	<!-- 대상: KJW_SCAR (7.62mm 중량형). CE 변환 - 7.62x51mm NATO 30발. -->
	<!-- KJW_SCAR (7.62mm 중량형) -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_SCAR</defName>
		<statBases>
			<SightsEfficiency>1.00</SightsEfficiency>
			<ShotSpread>0.09</ShotSpread>
			<SwayFactor>1.05</SwayFactor>
			<Bulk>5.0</Bulk>
			<Mass>3.5</Mass>
			<RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>1.5</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_SCAR_KJW</defaultProjectile>
			<warmupTime>1.0</warmupTime>
			<burstShotCount>6</burstShotCount>
			<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
			<range>55</range>
			<soundCast>NATOsmall_alt</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>9</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>30</magazineSize>
			<reloadTime>4.0</reloadTime>
			<ammoSet>AmmoSet_556x45mmNATO</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiUseBurstMode>TRUE</aiUseBurstMode>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
	</Operation>

	<!-- KJW_SCARH (7.62mm 스코프형) -->
	<Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
		<defName>KJW_SCARH</defName>
		<statBases>
			<SightsEfficiency>1.10</SightsEfficiency> <!-- 스코프 부착 -->
			<ShotSpread>0.09</ShotSpread>
			<SwayFactor>1.35</SwayFactor> <!-- 스코프, 흔들림↑ -->
			<Bulk>4.5</Bulk>
			<Mass>4.0</Mass>
			<RangedWeapon_Cooldown>1.2</RangedWeapon_Cooldown>
		</statBases>
		<Properties>
			<recoilAmount>1.7</recoilAmount>
			<verbClass>CombatExtended.Verb_ShootCE</verbClass>
			<hasStandardCommand>true</hasStandardCommand>
			<defaultProjectile>Bullet_SCARH_KJW</defaultProjectile>
			<warmupTime>0.9</warmupTime>
			<burstShotCount>6</burstShotCount>
			<ticksBetweenBurstShots>6</ticksBetweenBurstShots>
			<range>65</range>
			<soundCast>Heavy_fire</soundCast>
			<soundCastTail>GunTail_Medium</soundCastTail>
			<muzzleFlashScale>16</muzzleFlashScale>
		</Properties>
		<AmmoUser>
			<magazineSize>20</magazineSize>
			<reloadTime>4.5</reloadTime>
			<ammoSet>AmmoSet_762x51mmNATO</ammoSet>
		</AmmoUser>
		<FireModes>
			<aimedBurstShotCount>3</aimedBurstShotCount>
			<aiUseBurstMode>TRUE</aiUseBurstMode>
			<aiAimMode>AimedShot</aiAimMode>
		</FireModes>
	</Operation>

