<?xml version="1.0" encoding="utf-8" ?>
<Patch>

  <!-- 대상: EXOSUIT 중화기 7종(AMAR_Kinetic/AMR/ATM_EXO/AMHMG/HVMMG/SG_EXO/Rsevenhundred).
       바닐라 verbs(발사 로직)를 제거해 아래 MakeGunCECompatible이 CE verb로
       새로 정의할 수 있도록 정리한다. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_AMAR_Kinetic"]/verbs</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_AMR"]/verbs</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_ATM_EXO"]/verbs</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_AMHMG"]/verbs</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_HVMMG"]/verbs</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_SG_EXO"]/verbs</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_Rsevenhundred"]/verbs</xpath>
  </Operation>

  <!-- 대상: EXOSUIT 중화기 6종(Rsevenhundred 제외). 원본 CompProperties_RequiredApparel
       (바닐라식 필수 착용 체크)을 제거 - 동일 기능은 C# CERequiredApparelPatch.cs가
       CE Verb_ShootCE 레벨에서 대신 처리한다. -->
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_AMAR_Kinetic"]/comps/li[@Class="CompProperties_RequiredApparel"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_AMR"]/comps/li[@Class="CompProperties_RequiredApparel"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_ATM_EXO"]/comps/li[@Class="CompProperties_RequiredApparel"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_AMHMG"]/comps/li[@Class="CompProperties_RequiredApparel"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_HVMMG"]/comps/li[@Class="CompProperties_RequiredApparel"]</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <xpath>Defs/ThingDef[defName="KJW_SG_EXO"]/comps/li[@Class="CompProperties_RequiredApparel"]</xpath>
  </Operation>

  <!-- 대상: KJW_AMAR_Kinetic. CE 변환(.50 BMG/70발 탄창). -->
  <!-- AMAR : .50 BMG / 70 rounds -->
  <Operation Class="CombatExtended.PatchOperationMakeGunCECompatible">
    <defName>KJW_AMAR_Kinetic</defName>
    <statBases>
      <SightsEfficiency>0.78</SightsEfficiency>
      <ShotSpread>0.16</ShotSpread>
      <SwayFactor>1.35</SwayFactor>
      <Bulk>20.0</Bulk>
      <Mass>14.0</Mass>
      <RangedWeapon_Cooldown>0.35</RangedWeapon_Cooldown>
    </statBases>
    <Properties>
      <recoilAmount>3.2</recoilAmount>
      <verbClass>CombatExtended.Verb_ShootCE</verbClass>
      <hasStandardCommand>true</hasStandardCommand>
      <defaultProjectile>Bullet_50BMG_FMJ</defaultProjectile>
      <warmupTime>1.1</warmupTime>
      <burstShotCount>9</burstShotCount>
      <ticksBetweenBurstShots>7</ticksBetweenBurstShots>
      <range>62</range>
		<soundCast>AAMR_fire</soundCast>
      <soundCastTail>GunTail_Heavy</soundCastTail>
      <muzzleFlashScale>9</muzzleFlashScale>
    </Properties>
    <AmmoUser>
      <magazineSize>70</magazineSize>
      <reloadTime>6.8</reloadTime>
      <ammoSet>AmmoSet_50BMG</ammoSet>
    </AmmoUser>
    <FireModes>
      <aimedBurstShotCount>5</aimedBurstShotCount>
      <aiUseBurstMode>TRUE</aiUseBurstMode>
      <aiAimMode>Snapshot</aiAimMode>
    </FireModes>
  </Operation>  

